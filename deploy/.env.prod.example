# Copy to /opt/unpack/.env on the VM (chmod 600). Never commit the real file.
# Secrets:  openssl rand -hex 32
# Fernet:   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# --- deployment ---
UNPACK_REGISTRY=asia-south1-docker.pkg.dev/PROJECT_ID/unpack
UNPACK_IMAGE=asia-south1-docker.pkg.dev/PROJECT_ID/unpack/server:latest
POSTGRES_PASSWORD=CHANGE_ME_hex_no_special_chars

# --- app ---
# The Cloud Run front door URL: https://unpack-<PROJECT_NUMBER>.asia-south1.run.app
UNPACK_BASE_URL=https://unpack-PROJECT_NUMBER.asia-south1.run.app
DATABASE_URL=postgresql://unpack:CHANGE_ME_hex_no_special_chars@postgres:5432/unpack
DATA_DIR=/data

SESSION_SECRET=
RENDER_TOKEN_SECRET=
ADMIN_TOKEN=
# Keep the SAME key as your local .env if you migrate existing data, or stored GitHub tokens cannot be decrypted.
TOKEN_ENCRYPTION_KEY=

GITHUB_API_URL=https://api.github.com
GITHUB_APP_ID=
GITHUB_APP_SLUG=unpack
GITHUB_APP_PRIVATE_KEY_PATH=/secrets/app.pem
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

REASONING_ENABLED=false
GEMINI_BACKEND=ai_studio
GEMINI_API_KEY=

# Sizing for e2-standard-4 (4 vCPU / 16 GB). Use 1 / 1 on e2-standard-2.
ANALYSIS_PROCESSES=2
WORKER_CONCURRENCY=2
RECONCILE_INTERVAL_SECONDS=10
PR_WAIT_DAYS=3
PR_DESCRIPTION_SECTION=true
