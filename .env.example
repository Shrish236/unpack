# Unpack Environment Configuration
# Base URLs & Networking
UNPACK_BASE_URL=http://localhost:8000

# Database & Graph DB
DATABASE_URL=postgresql://unpack:unpackpass@localhost:5432/unpack
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=unpackpass

# Gemini AI Processing
GEMINI_BACKEND=ai_studio
GEMINI_API_KEY=your_gemini_api_key_here
# Vertex AI config (optional):
GCP_PROJECT=
GCP_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=/secrets/gcp.json

GEMINI_MODEL_PRIMARY=gemini-3.1-pro-preview
GEMINI_MODEL_FALLBACK=gemini-2.5-pro
GEMINI_MODEL_REPAIR=gemini-3.5-flash
GEMINI_TIMEOUT_S=120
GEMINI_CONCURRENCY=2
GEMINI_MAX_INPUT_TOKENS=200000
GEMINI_MAX_OUTPUT_TOKENS=16384
GEMINI_DAILY_TOKEN_BUDGET_PER_REPO=5000000
PROMPT_VERSION=1

# GitHub App Configuration
GITHUB_API_URL=https://api.github.com
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=/secrets/app.pem
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=

# Security & Sessions
SESSION_SECRET=unpack_session_secret_change_in_production_min32chars
TOKEN_ENCRYPTION_KEY=D7kRj9UqQ3sV4wX8yZ0aBcDeFgHiJkLmNoPqRsTuVwX=
RENDER_TOKEN_SECRET=unpack_render_token_secret_min32chars
ADMIN_TOKEN=unp_admin_secret_token_default

# Storage & Operations
DATA_DIR=/data
WORKER_CONCURRENCY=2
RECONCILE_INTERVAL_SECONDS=30
TRACK_MAX_DAYS=7
MAX_GRAPH_NODES=200
MAX_GRAPH_EDGES=500
MAX_NEIGHBORS_PER_NODE=15
IMPACT_DEPTH=3
MAX_LLM_FUNCTIONS=50
