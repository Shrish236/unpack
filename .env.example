# Unpack environment configuration. Copy to .env and replace every secret.
# Generate values with:  openssl rand -hex 32   (TOKEN_ENCRYPTION_KEY: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")

UNPACK_BASE_URL=https://unpack.example.com
INTERNAL_API_URL=http://127.0.0.1:8000

DATABASE_URL=postgresql://unpack:CHANGE_ME@localhost:5432/unpack

# Reasoning (LLM) is a placeholder in this build; leave false.
REASONING_ENABLED=false
GEMINI_API_KEY=
GEMINI_BACKEND=ai_studio

# GitHub App (create it with the public URL above; see README)
GITHUB_API_URL=https://api.github.com
GITHUB_APP_ID=
GITHUB_APP_SLUG=unpack
GITHUB_APP_PRIVATE_KEY_PATH=/secrets/app.pem
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=

# Required secrets (the server refuses to start without them)
SESSION_SECRET=replace_with_openssl_rand_hex_32_output
RENDER_TOKEN_SECRET=replace_with_openssl_rand_hex_32_output
ADMIN_TOKEN=replace_with_openssl_rand_hex_32_output
TOKEN_ENCRYPTION_KEY=replace_with_fernet_key

DATA_DIR=/data
WORKER_CONCURRENCY=2
RECONCILE_INTERVAL_SECONDS=30
TRACK_MAX_DAYS=7
MAX_GRAPH_NODES=200
MAX_GRAPH_EDGES=500
MAX_NEIGHBORS_PER_NODE=15
IMPACT_DEPTH=3
