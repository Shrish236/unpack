{
  "$defs": {
    "ChangedFilePayload": {
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "old_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Old Path"
        },
        "status": {
          "enum": [
            "A",
            "M",
            "D",
            "R"
          ],
          "title": "Status",
          "type": "string"
        },
        "is_binary": {
          "default": false,
          "title": "Is Binary",
          "type": "boolean"
        },
        "base_content": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Base Content"
        },
        "head_content": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Head Content"
        },
        "truncated": {
          "default": false,
          "title": "Truncated",
          "type": "boolean"
        }
      },
      "required": [
        "path",
        "status"
      ],
      "title": "ChangedFilePayload",
      "type": "object"
    },
    "ClientMetadata": {
      "properties": {
        "cli_version": {
          "default": "0.1.0",
          "title": "Cli Version",
          "type": "string"
        },
        "os": {
          "default": "unknown",
          "title": "Os",
          "type": "string"
        },
        "hook": {
          "default": "pre-push",
          "title": "Hook",
          "type": "string"
        }
      },
      "title": "ClientMetadata",
      "type": "object"
    },
    "CommitPayload": {
      "properties": {
        "sha": {
          "title": "Sha",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "author_time": {
          "title": "Author Time",
          "type": "string"
        }
      },
      "required": [
        "sha",
        "message",
        "author_time"
      ],
      "title": "CommitPayload",
      "type": "object"
    },
    "RepoRef": {
      "properties": {
        "owner": {
          "title": "Owner",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "remote_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Remote Url"
        },
        "default_branch": {
          "default": "main",
          "title": "Default Branch",
          "type": "string"
        }
      },
      "required": [
        "owner",
        "name"
      ],
      "title": "RepoRef",
      "type": "object"
    },
    "SessionPayload": {
      "properties": {
        "agent": {
          "title": "Agent",
          "type": "string"
        },
        "agent_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Agent Version"
        },
        "file_name": {
          "title": "File Name",
          "type": "string"
        },
        "lines": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Lines",
          "type": "array"
        }
      },
      "required": [
        "agent",
        "file_name"
      ],
      "title": "SessionPayload",
      "type": "object"
    }
  },
  "properties": {
    "schema_version": {
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "repo": {
      "$ref": "#/$defs/RepoRef"
    },
    "branch": {
      "title": "Branch",
      "type": "string"
    },
    "base_sha": {
      "title": "Base Sha",
      "type": "string"
    },
    "head_sha": {
      "title": "Head Sha",
      "type": "string"
    },
    "commits": {
      "items": {
        "$ref": "#/$defs/CommitPayload"
      },
      "title": "Commits",
      "type": "array"
    },
    "diff": {
      "default": "",
      "title": "Diff",
      "type": "string"
    },
    "changed_files": {
      "items": {
        "$ref": "#/$defs/ChangedFilePayload"
      },
      "title": "Changed Files",
      "type": "array"
    },
    "session": {
      "anyOf": [
        {
          "$ref": "#/$defs/SessionPayload"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "redactions": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "Redactions",
      "type": "object"
    },
    "client": {
      "$ref": "#/$defs/ClientMetadata"
    }
  },
  "required": [
    "repo",
    "branch",
    "base_sha",
    "head_sha"
  ],
  "title": "IngestPayload",
  "type": "object"
}